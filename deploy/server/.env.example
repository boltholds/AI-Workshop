AI_WORKSHOP_HTTPS_BIND=127.0.0.1:8443
AI_WORKSHOP_BROWSER_TOKEN=replace-with-bootstrap-generated-token
AI_WORKSHOP_RUNTIME_SOCKET=/run/user/1000/docker.sock
AI_WORKSHOP_STORAGE_ROOT=/var/lib/ai-workshop/storage
AI_WORKSHOP_MCP_PORT=8765

# Optional isolated analysis overlay (separate random secrets).
AI_WORKSHOP_ANALYSIS_TOKEN=replace-with-random-analysis-token
AI_WORKSHOP_CARGO_PREFETCH_TOKEN=replace-with-another-random-prefetch-token
